/* The modes appended to the test bundle before native-body.jxa: the
 * supervisor against real processes,
 * each question shown by the real Standard Additions, the saved settings in a
 * domain of the suite's own, and the name presentation.
 */
function superviseMode(bridge, files, base) {
    "use strict";
    const supervise = __TermAtTarget.supervise;
    const ran = function (script) {
        // Match the production deadline's monotonic time basis.
        const started = bridge.now();
        const result = supervise(bridge, files, { executable: "/bin/sh", arguments: ["-c", script], operation: "launch", subject: "/bin/sh" });
        result.seconds = bridge.now() - started;
        return result;
    };
    let unstartable = null;
    try {
        supervise(bridge, files, { executable: base + "/file.txt", arguments: [], operation: "launch", subject: base + "/file.txt" });
    } catch (error) { unstartable = error.kind; }
    return {
        quiet: ran("exit 0"),
        failing: ran("printf oops >&2; exit 3"),
        lingering: ran("(sleep 20 >&2 &); exit 1"),
        flood: ran("exec /usr/bin/yes >&2"),
        stubborn: ran("trap '' TERM; while :; do sleep 1; done"),
        unstartable: unstartable
    };
}

/* Each question, shown by the real Standard Additions with exactly the
 * options the artifact passes, plus a one-second limit so nobody has to
 * answer. Timing out is not one of the offered buttons, so the artifact must
 * refuse it -- which shows the options were accepted as given.
 */
function dialogsMode(host, base) {
    "use strict";
    const app = Application.currentApplication();
    app.includeStandardAdditions = true;
    const timed = {
        displayDialog: function (text, options) {
            return app.displayDialog(text, Object.assign({}, options, { givingUpAfter: 1 }));
        },
        displayAlert: function (text, options) {
            return app.displayAlert(text, Object.assign({}, options, { givingUpAfter: 1 }));
        }
    };
    const questions = __TermAtTarget.createQuestions(timed);
    const ports = Object.assign({}, host, questions, {
        preferences: { load: function () { return { terminal: null, folder: null, link: null }; } }
    });
    const askInRun = function (input) { return __TermAtTarget.execute(__TermAtTarget.readSelection(input, ports.files), ports); };
    const refusal = function (ask) {
        try { ask(); } catch (error) { return error.kind || String(error.message); }
        return null;
    };
    return {
        start: refusal(function () { askInRun([]); }),
        folder: refusal(function () { askInRun([base + "/Demo.app"]); }),
        link: refusal(function () { askInRun([base + "/relative-link"]); }),
        alert: refusal(function () { __TermAtTarget.createFailureReport(timed)(new Error("A failure, shown for a second.")); })
    };
}

/* Each invocation uses a separate process and a project-owned test domain.
 * A volatile registration also checks that a fallback is not read as saved.
 */
function overlappingSave(bridge, preferences, step, directory) {
    const folder = step === "overlap-folder";
    const key = folder ? "folder" : "terminal";
    const peer = folder ? "terminal" : "folder";
    const ready = directory + "/" + key;
    const other = directory + "/" + peer;
    const files = $.NSFileManager.defaultManager;
    const limit = bridge.now() + 10;

    // Both writers read the initial record before either writes its key.
    preferences.load();
    if (!$("ready").writeToFileAtomicallyEncodingError(ready, true, $.NSUTF8StringEncoding, $())) {
        throw new Error("Could not coordinate the preferences writers.");
    }
    while (!files.fileExistsAtPath(other)) {
        if (bridge.now() > limit) {
            throw new Error("The other preferences writer did not reach the barrier.");
        }
        $.NSThread.sleepForTimeInterval(0.01);
    }
    preferences.save(key, folder ? "parent" : "kitty");
}

function preferencesMode(bridge, domain, step, directory) {
    "use strict";
    $.NSUserDefaults.standardUserDefaults.registerDefaults($({ terminal: "termattarget-native-check" }));
    const preferences = __TermAtTarget.createPreferences(bridge, domain);
    if (step === "overlap-folder" || step === "overlap-terminal") {
        overlappingSave(bridge, preferences, step, directory);
    }
    if (step === "folder") {
        preferences.save("folder", "parent");
        $.NSUserDefaults.alloc.initWithSuiteName(domain).setIntegerForKey(3, "link");
    }
    if (step === "terminal") {
        preferences.save("terminal", "kitty");
    }
    return preferences.load();
}

/* Each name, as the engine osascript runs presents it; compared by the suite
 * with the same names presented by Node, since the Unicode property tables
 * the rule relies on belong to each engine.
 */
function presentMode(names) {
    "use strict";
    return names.map(function (name) { return __TermAtTarget.presentName(name); });
}
