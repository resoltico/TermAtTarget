/* Appended to the generated artifact, after native-modes.jxa, in a temporary
 * copy made by macos.mjs.
 * Replaces only its OSA run entry point. Real native adapters remain unchanged.
 * Out-parameters are made with $(), as the artifact makes them: an NSError
 * read back out of a Ref() crashes osascript (see src/runtime/bridge.js).
 */
function run(argv) {
    "use strict";
    ObjC.import("Foundation");
    const mode = argv[0];
    const base = argv[1];
    const host = __TermAtTarget.createMacHost();
    const bridge = { ns: $, objc: ObjC, outParameter: function () { return $(); },
        now: function () { return $.NSProcessInfo.processInfo.systemUptime; } };
    const files = __TermAtTarget.forNativeTests.createFoundation(bridge);
    function insist(condition, label) {
        if (!condition) { throw new Error("Native assertion failed: " + label); }
    }
    function makeAlias(target, name) {
        const error = $();
        const data = $.NSURL.fileURLWithPath(target).bookmarkDataWithOptionsIncludingResourceValuesForKeysRelativeToURLError(
            $.NSURLBookmarkCreationSuitableForBookmarkFile, $(), $(), error
        );
        insist(!data.isNil(), "bookmark creation");
        insist($.NSURL.writeBookmarkDataToURLOptionsError(data, $.NSURL.fileURLWithPath(name), 0, error), "alias file writing");
    }
    if (mode === "alias") {
        makeAlias(argv[2], argv[3]);
        return JSON.stringify({ alias: argv[3] });
    }
    if (mode === "terminal") {
        host.files.validateDirectory(argv[2]);
        host.terminals.launch(argv[3], argv[2]);
        return JSON.stringify({ handedToOpen: true });
    }
    if (mode === "installed") {
        return JSON.stringify(JSON.parse(argv[2]).filter(function (id) { return host.terminals.isInstalled(id); }));
    }
    if (mode === "preferences") {
        return JSON.stringify(preferencesMode(bridge, argv[2], argv[3]));
    }
    if (mode === "supervise") {
        return JSON.stringify(superviseMode(bridge, files, base));
    }
    if (mode === "present") {
        return JSON.stringify(presentMode(JSON.parse(argv[2])));
    }
    if (mode === "dialogs") {
        return JSON.stringify(dialogsMode(files, base));
    }
    insist(mode === "main", "recognized test mode");
    const passed = [];
    function record(condition, label) { insist(condition, label); passed.push(label); }
    // Refused with its own message: a TypeError from a broken bridge call
    // would be a failure too, and must not pass for the refusal expected.
    function fails(action, expected, label) {
        let message = null;
        try { action(); } catch (error) { message = String(error && error.message); }
        insist(message !== null && expected.test(message),
            label + ": " + (message === null ? "nothing was refused" : message));
        passed.push(label);
    }
    makeAlias(base + "/folder", base + "/folder-alias");
    insist($.NSFileManager.defaultManager.createSymbolicLinkAtPathWithDestinationPathError(base + "/link-to-file", "file.txt", $()), "link to a file fixture");
    insist($.NSFileManager.defaultManager.createSymbolicLinkAtPathWithDestinationPathError(base + "/link-to-alias", "folder-alias", $()), "link to an alias fixture");
    makeAlias(base + "/file.txt", base + "/file-alias");
    makeAlias(base + "/doomed.txt", base + "/broken-alias");
    insist($.NSFileManager.defaultManager.removeItemAtPathError(base + "/doomed.txt", $()), "remove alias target fixture");

    record(host.files.inspect(base + "/folder").kind === "directory", "Foundation directory classification");
    record(host.files.inspect(base + "/file.txt").kind === "file", "Foundation file classification");
    record(host.files.inspect(base + "/folder-alias").kind === "alias", "Finder alias classification");
    record(host.files.inspect(base + "/broken-alias").kind === "alias", "broken alias classification without target resolution");
    record(host.files.inspect(base + "/relative-link").kind === "symlink", "lstat-like symlink classification");
    record(files.isPackage(base + "/Demo.app") === true && files.isPackage(base + "/folder") === false, "package metadata, asked on its own");
    record(files.isPackage(base + "/missing") === false, "an unanswerable package question reads as a folder");
    record(host.files.pathOf(Path(base + "/folder-alias")) === base + "/folder-alias", "Path preserves alias pathname");
    record(host.files.pathOf($(base + "/file.txt")) === base + "/file.txt", "NSString input");
    const reference = $.NSURL.fileURLWithPath(base + "/file.txt").fileReferenceURL;
    record(/^file:\/\/\/\.file\/id=/.test(ObjC.unwrap(reference.absoluteString)), "a file-reference URL fixture is one");
    record(decodeURIComponent(host.files.pathOf(reference).replace(/^file:\/\//, "")) === base + "/file.txt", "a file-reference URL reads as its path");
    for (const suffix of ["/%ZZ", "/%2f", "/%2F", "/%FF"]) {
        const text = ObjC.unwrap(reference.absoluteString) + suffix;
        fails(function () { host.files.pathOf(text); }, /invalid percent-encoding|encoded path separator/, "invalid textual reference " + suffix);
    }
    for (const suffix of ["/%2f", "/%2F", "/%FF"]) {
        const nativeURL = $.NSURL.URLWithString(ObjC.unwrap(reference.absoluteString) + suffix);
        fails(function () { host.files.pathOf(nativeURL); }, /invalid percent-encoding|encoded path separator/, "invalid native reference " + suffix);
    }
    record(host.files.readLink(base + "/relative-link") === "folder", "relative link content preserved");
    record(host.files.resolveAlias(base + "/folder-alias") === base + "/folder", "alias target resolution");
    fails(function () { host.files.resolveAlias(base + "/broken-alias"); }, /^Cannot resolve alias target for /, "broken target reported as an error");
    fails(function () { host.files.inspect(base + "/missing"); }, /^Cannot inspect ".*\(NSCocoaErrorDomain 260\)$/, "missing item reported with its domain and code");
    fails(function () { host.files.validateDirectory(base + "/file.txt"); }, /^The destination is no longer a directory: /, "non-directory launch destination rejected");
    fails(function () { host.files.validateDirectory(base + "/locked"); }, /^The destination directory cannot be entered: /, "a folder that cannot be entered is refused");
    fails(function () { host.files.resolveAlias(base + "/volume-alias"); }, /^Cannot resolve alias target for /, "an alias to an ejected volume is refused, not remounted");
    host.files.validateDirectory(base + "/folder");

    const opened = [];
    // The real filesystem, with settings, questions and the launch standing in.
    function planned(folder, link) {
        return {
            files: host.files,
            preferences: { load: function () { return { terminal: null, folder: folder, link: link }; } },
            terminals: { isInstalled: function () { return true; }, launch: function (id, path) { opened.push(path); } },
            questions: function () {
                return {
                    start: function () { return "choose"; },
                    chooseFolder: function () { return Path(base + "/folder"); },
                    chooseFolderMode: function () { return "inside"; },
                    chooseLink: function () { return "follow"; }
                };
            }
        };
    }
    function check(input, folder, link, expected, label) {
        const previous = opened.length;
        __TermAtTarget.execute(input, planned(folder, link));
        record(opened.length === previous + 1 && opened[previous] === expected, label);
    }
    const envelope = function (items) { return [items, { source: "", "temporary items path": "/tmp", ignoresInput: false }]; };
    check([], "parent", "ask", base + "/folder", "a chosen folder opens inside it, whatever folders are set to");
    check(envelope([Path(base + "/file.txt")]), "ask", "ask", base, "the Shortcuts envelope with a Path");
    check([Path(base + "/folder")], "parent", "ask", base, "native Path folder parent");
    check([$.NSURL.fileURLWithPath(base + "/file.txt")], "ask", "ask", base, "native NSURL file input");
    check([reference], "ask", "ask", base, "native file-reference NSURL input");
    check([$.NSURL.fileURLWithPath(base + "/relative-link")], "inside", "follow", base + "/folder", "a URL for a link to a folder, slash and all");
    check([base + "/folder-alias"], "inside", "follow", base + "/folder", "alias followed to a directory");
    check([base + "/file-alias"], "ask", "follow", base, "alias followed to a file\u2019s folder");
    check([base + "/broken-alias"], "ask", "stay", base, "broken alias opens where it is");
    check([base + "/broken-link"], "ask", "stay", base, "broken symlink own location");
    check([base + "/relative-link"], "inside", "follow", base + "/folder", "relative symlink followed");
    check([base + "/relative-link/child.txt"], "ask", "ask", base + "/relative-link", "file parent may be a directory symlink without changing its spelling");
    check([base + "/ordered-link"], "inside", "follow", base + "/elsewhere/goal", "symlink/../goal native traversal order");
    check([base + "/odd ' \n$`;&😀/item.txt"], "ask", "ask", base + "/odd ' \n$`;&😀", "hostile Unicode/newline path stays exact");
    check(["/"], "ask", "ask", "/", "root opens without a folder question");
    check([base + "/relative-link/"], "inside", "stay", base, "a slashed link to a folder still opens where the link sits");
    check([ObjC.unwrap(reference.absoluteString)], "ask", "ask", base, "a file-reference URL written as text opens where it refers");
    const count = opened.length;
    const configured = planned("inside", "follow");
    fails(function () { __TermAtTarget.execute([base + "/file.txt", base + "/folder"], configured); }, /one selected item at a time/, "multiple selection rejected");
    fails(function () { __TermAtTarget.execute([base + "/file.txt/"], configured); }, /ends in "\/", but it names a file/, "a path ending in / cannot name a file");
    fails(function () { __TermAtTarget.execute([base + "/cycle"], configured); }, /link cycle/, "symlink cycle rejected");
    fails(function () { __TermAtTarget.execute([base + "/link-to-file/"], configured); }, /ends in "\/", but it leads to a file/, "a slashed link to a file is refused");
    fails(function () { __TermAtTarget.execute([base + "/link-to-alias/"], configured); }, /ends in "\/", but it leads to a file/, "a slashed link to a Finder alias is refused");
    fails(function () { __TermAtTarget.execute([base + "/folder"], planned("LEVEL", "ask")); }, /^The saved folder setting, "LEVEL", is not one of/, "an unrecognised saved setting is refused");
    record(opened.length === count, "failed planning does not launch");
    return JSON.stringify({ passed: passed, count: passed.length,
        os: ObjC.unwrap($.NSProcessInfo.processInfo.operatingSystemVersionString) });
}
